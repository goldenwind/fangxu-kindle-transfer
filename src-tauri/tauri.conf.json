{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "方序传书",
  "version": "1.2.0",
  "identifier": "com.fangxu.kindle-transfer",
  "build": {
    "beforeDevCommand": "npm run build:icons && npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:icons && npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "方序传书",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/fangxu-kindle-service"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "在局域网中将电子书传到 Kindle",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "../packaging/macos/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 390
        },
        "appPosition": {
          "x": 170,
          "y": 174
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 174
        }
      }
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
